# Credora configuration. Copy to `.env` in the repository root and fill in.
# Used by docker-compose.yml (application + observability) and
# ci/docker-compose.yml (Jenkins + SonarQube).

# --- Application -------------------------------------------------------------
APP_NAME=PBIP API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Supabase PostgreSQL (transaction pooler), asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT>:<PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres

JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Service log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Observability -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- CI/CD -------------------------------------------------------------------
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin
# Replaces SonarQube's default admin/admin on first start. Must have at least
# 12 characters with upper case, lower case, a digit and a special character.
SONAR_ADMIN_PASSWORD=Credora@Sonar1
