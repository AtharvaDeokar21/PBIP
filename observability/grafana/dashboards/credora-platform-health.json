      "targets": [
        {
          "expr": "default_jenkins_builds_last_build_result_ordinal{jenkins_job=\"credora\"}",
          "legendFormat": "",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SUCCESS",
                  "color": "green"
                },
                "1": {
                  "text": "UNSTABLE",
                  "color": "yellow"
                },
                "2": {
                  "text": "FAILURE",
                  "color": "red"
                },
                "3": {
                  "text": "NOT BUILT",
                  "color": "gray"
                },
                "4": {
                  "text": "ABORTED",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
