    {
      "id": 15,
      "type": "logs",
      "title": "Gateway access log",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "expr": "{service=\"gateway\"} | json | __error__=\"\" | line_format \"{{.status}} {{.method}} {{.uri}} {{.request_time}}s -> {{.upstream}} rid={{.request_id}}\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
